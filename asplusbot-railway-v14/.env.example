# شناسهٔ دقیق گروه (ترجیحاً @username یا ID، نه نام نمایشی)
SOROUSH_GROUP_ID=
# یوزرنیم/لینک گروه برای فراخوانی‌های SoroPy، مثل @Testgroups
SOROUSH_GROUP_TARGET=
# شمارهٔ حساب شخصیِ ادمین؛ هرگز آن را در git ثبت نکنید.
SOROUSH_PHONE=
# websocket برای رویداد لحظه‌ای گروه توصیه می‌شود.
SOROUSH_BACKEND=websocket
# مسیرهای Volume پایدار Railway
DATABASE_PATH=/data/manager.db
SESSION_NAME=/data/session/soroush.session
SESSION_DIR=/data/session
# مدیران افزودهٔ ربات، با کاما جدا شوند. خود ادمین‌های واقعی گروه همچنان سمت سرور بررسی می‌شوند.
EXTRA_ADMINS=
# فراخوان گروه‌های شلوغ: حداکثر اعضا، تعداد هر پیام و فاصلهٔ بین پیام‌ها
CALL_MEMBERS_LIMIT=500
CALL_MEMBERS_BATCH=20
CALL_MEMBERS_DELAY_SECONDS=1.5
# منطقهٔ زمانی و فاصلهٔ بررسی باز/بسته‌شدن خودکار چت
CHAT_SCHEDULE_TIMEZONE=+03:30
CHAT_SCHEDULE_CHECK_SECONDS=20
